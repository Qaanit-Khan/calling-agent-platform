# ============================================================
# Calling Agent Backend — Environment Configuration
# Copy this file to .env and configure with your credentials.
# ============================================================

# ---- Server Configuration ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
ENVIRONMENT=development

# Public URL (Tunnel or Production Domain for Telephony Webhooks like VoBiz/Twilio)
# Example: https://your-ngrok-subdomain.ngrok-free.dev or http://localhost:8001
BACKEND_PUBLIC_URL=http://localhost:8001

# Allowed frontend origins (JSON array or comma-separated)
CORS_ORIGINS=["*"]

# Optional API Key for securing backend endpoints (leave blank for local dev)
APP_API_KEY=

# ---- Database Configuration ----
# Option 1: SQLite (Default zero-config local setup)
DATABASE_URL=sqlite+aiosqlite:///./calling_agent.db

# Option 2: PostgreSQL (Recommended for production)
# DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/voxora

# ---- Telephony Engine Configuration ----
# Options: sarvam | dograh
VOICE_ENGINE=sarvam
ACTIVE_MODEL_MODE=sarvam

# ---- Sarvam AI Credentials (Primary Voice & LLM Engine) ----
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_DEFAULT_VOICE=meera
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-2b

# ---- Google Gemini AI (Optional / Fallback LLM) ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- VoBiz Telephony Provider ----
VOBIZ_AUTH_ID=your_vobiz_auth_id
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token
VOBIZ_FROM_NUMBER=+91XXXXXXXXXX
VOBIZ_APPLICATION_ID=your_vobiz_application_id

# ---- Twilio Telephony Provider (Optional Alternative) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Dograh Telephony / Voice Platform (Optional) ----
DOGRAH_BASE_URL=http://localhost:8000
DOGRAH_API_KEY=sk-your-dograh-api-key
DOGRAH_WEBHOOK_SECRET=

# ---- Redis & MinIO / S3 Storage (Optional) ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=voxora-recordings
S3_REGION=us-east-1
